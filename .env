# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ibl_db

# AWS Configuration (add your credentials when ready)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Application Settings
APP_NAME=Intelligent Baggage Loading System
DEBUG=True
API_VERSION=v1
MAX_BAGGAGE_WEIGHT=32  # maximum weight in kg for a single baggage
MAX_BAGGAGE_VOLUME=0.2  # maximum volume in cubic meters