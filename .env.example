# Boeing 737 Weight & Balance Optimizer - Environment Variables

# Database Configuration
DATABASE_TYPE=dynamodb  # Options: dynamodb, postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/weight_optimizer
REDIS_URL=redis://localhost:6379/0

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=weight-optimizer
DYNAMODB_ENDPOINT_URL=  # Leave empty for AWS service, set for local development

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_ACCOUNT_ID=123456789012

# PingFederate SSO Authentication
PINGFEDERATE_CLIENT_ID=your_client_id
PINGFEDERATE_SSO_ENDPOINT=https://sso.company.com
PINGFEDERATE_REDIRECT_URI=https://demo.dev.balanceiq.com/auth/callback
PINGFEDERATE_LOGOUT_URL=https://sso.company.com/idp/startSLO.ping
JWT_SECRET_KEY=your_jwt_secret_key_here

# Legacy System Integration
WB_USERNAME=wb_user
WB_PASSWORD=wb_password
DCS_CLIENT_ID=dcs_client_id
DCS_CLIENT_SECRET=dcs_client_secret
MRO_API_KEY=mro_api_key
FOS_USERNAME=fos_user
FOS_PASSWORD=fos_password

# Weather Service
WEATHER_API_KEY=your_weather_api_key

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production
FRONTEND_URL=https://demo.dev.balanceiq.com

# MQTT/IoT Configuration
MQTT_BROKER_HOST=mqtt.demo.dev.balanceiq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password

# Monitoring
SENTRY_DSN=https://your_sentry_dsn_here