# Boeing 737 Weight & Balance Optimizer Configuration

# Database Configuration
DATABASE_TYPE=dynamodb  # Options: dynamodb, postgresql
DATABASE_URL=postgresql://weight_user:password@localhost:5432/weight_optimizer

# DynamoDB Configuration (if using DynamoDB)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
DYNAMODB_TABLE_PREFIX=weight_optimizer

# Application Configuration
SECRET_KEY=your-secret-key-here
DEBUG=true
LOG_LEVEL=INFO

# PingFederate SSO Configuration
PINGFEDERATE_BASE_URL=https://your-pingfederate-server.com
PINGFEDERATE_CLIENT_ID=your-client-id
PINGFEDERATE_CLIENT_SECRET=your-client-secret
PINGFEDERATE_REDIRECT_URI=http://localhost:8000/auth/callback

# AWS Services Configuration
AWS_CLOUDWATCH_ENABLED=true
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:weight-optimizer-alerts

# External API Configuration
WEATHER_API_KEY=your-weather-api-key
AIRLINE_DCS_ENDPOINT=https://your-dcs-system.com/api
MAINTENANCE_SYSTEM_URL=https://your-maintenance-system.com

# MQTT Configuration for IoT Devices
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_password

# Phase 6: Advanced Features (Optional)
# Enable/disable advanced features independently

# Machine Learning Optimization
ENABLE_ML_OPTIMIZATION=false
ML_MODEL_PATH=/path/to/ml/models
ML_TRAINING_DATA_PATH=/path/to/training/data

# Compliance Reporting
ENABLE_COMPLIANCE_REPORTING=false
FAA_REPORTING_ENDPOINT=https://faa-reporting-system.gov/api
COMPLIANCE_REPORT_SCHEDULE=daily

# Predictive Analytics
ENABLE_PREDICTIVE_ANALYTICS=false
ANALYTICS_DATA_RETENTION_DAYS=365
ANALYTICS_MODEL_UPDATE_INTERVAL=weekly

# Mobile Integration
ENABLE_MOBILE_INTEGRATION=false
PUSH_NOTIFICATION_SERVICE=firebase
FIREBASE_SERVER_KEY=your-firebase-server-key
MOBILE_API_VERSION=v2

# Advanced Legacy System Integrations
ENABLE_ADVANCED_INTEGRATIONS=false
CREW_SCHEDULING_API=https://crew-system.com/api
PASSENGER_MANIFEST_API=https://manifest-system.com/api
BAGGAGE_RECONCILIATION_API=https://baggage-system.com/api

# Performance and Scaling
MAX_CONCURRENT_CALCULATIONS=100
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=1000

# Security Configuration
CORS_ORIGINS=http://localhost:3000,https://demo.dev.balanceiq.com
JWT_EXPIRATION_HOURS=24
SESSION_TIMEOUT_MINUTES=30

# Monitoring and Observability
METRICS_COLLECTION_INTERVAL=60
LOG_STRUCTURED_FORMAT=true
TRACE_SAMPLING_RATE=0.1